{
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}"
  },

  "hyprland/window": {
    "rewrite": {
      "(.*) - Chromium": "$1",
      "(.*) - Brave": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) — Zen Browser": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1"
    },
	"icon": true,
    "separate-outputs": true,
    "max-length": 70
  },

  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout -b 4",
    "tooltip": false
  },

  "custom/g703": {
    "exec": "~/.config/waybar/scripts/mouse_battery.sh",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "on-click": "solaar"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "clock": {
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "format": "{:%a %Y-%m-%d %H:%M}"
  },

  "cpu": {
    "format": "{usage:>3}% 󰻠"
  },

  "memory": {
    "format": "{percentage:>3}% 󰍛"
  },

  "disk": {
    "interval": 30,
    "format": "{percentage_used}% 󰋊",
    "path": "/",
    "on-click": "foot -e htop"
  },

  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/system",
      "disk",
      "cpu",
      "memory",
      "hyprland/language"
    ]
  },

  "network": {
    "format": "󰖩",
    "format-disconnected": "󰖪",
    "tooltip-format": "Network: {ifname} via {gwaddr}",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "foot -e nmtui"
  },

  "battery": {
    "states": {
      "good": 90,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% 󰚥",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀"
    ]
  },

  "pulseaudio": {
    "scroll-step": 1,
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "󰖁 ",
    "format-muted": "󰝟",
    "format-source": " {volume}% 󰍬",
    "format-source-muted": " 󰍭",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol"
  },

  "bluetooth": {
    "format-disabled": "",
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": ""
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "on-click-right": "hyprlock"
  }
}
